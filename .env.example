# ===== 数据库（本地/自建服务器可全部留空，自动使用本地 SQLite）=====

# 数据库连接地址
#   本地（默认）: 留空即可，自动使用 file:data/blog.db
#   Vercel/Turso : libsql://你的数据库.turso.io
DATABASE_URL=

# Turso 数据库鉴权 Token（仅远程模式需要）
#   创建方法：https://turso.tech 注册后 turso db create + turso db tokens create
TURSO_AUTH_TOKEN=

# ===== 后台管理 =====

# 后台登录密码（生产环境必设！）
ADMIN_PASSWORD=

# 站点域名，用于 RSS / sitemap 生成（如 https://your-site.com）
SITE_URL=

# ===== 图片上传（Vercel 需要；自建服务器可留空，使用本地存储）=====

# Vercel Blob 读写 Token：https://vercel.com/docs/storage/vercel-blob
# 设置了它，上传的图片会存到 Vercel Blob（对象存储），serverless 下可持久
BLOB_READ_WRITE_TOKEN=
